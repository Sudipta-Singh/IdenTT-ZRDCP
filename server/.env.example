# Copy this file to .env and fill in your own real credentials:
#   cp .env.example .env
# NEVER commit .env — it's already listed in server/.gitignore. This server is the ONLY place
# these secrets should ever live; the browser app never sees them, it only calls this server's
# /send-email and /send-sms endpoints over localhost.

PORT=4737

# --- Email (SMTP via Nodemailer) ---
# Example for Gmail: host smtp.gmail.com, port 587, secure=false, and an App Password
# (https://myaccount.google.com/apppasswords) — NOT your normal account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional — defaults to SMTP_USER if left blank.
SMTP_FROM=

# --- SMS (Twilio) ---
# Find these in the Twilio Console (https://console.twilio.com). TWILIO_FROM_NUMBER must be a
# phone number or Messaging Service sender you own in your Twilio account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
